Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"

  config.vm.boot_timeout = 600

  config.vm.synced_folder ".", "/vagrant", disabled: true

  machines = {
    "clickhouse-01" => {
      ip: "192.168.77.11",
      forwarded_ports: [
        { guest: 22, host: 8022 },
        { guest: 8123, host: 8023 }
      ],
      memory: 2048,
      cpus: 2
    },
    "vector-01" => {
      ip: "192.168.77.12",
      forwarded_ports: [
        { guest: 22, host: 8122 }
      ],
      memory: 1024,
      cpus: 1
    },
    "lighthouse-01" => {
      ip: "192.168.77.13",
      forwarded_ports: [
        { guest: 22, host: 8222 },
        { guest: 80, host: 8280 }
      ],
      memory: 1024,
      cpus: 1
    }
  }

  machines.each do |name, settings|
    config.vm.define name do |machine|

      machine.vm.hostname = name

      machine.vm.network "private_network",
        ip: settings[:ip]

      settings[:forwarded_ports].each do |port|
        machine.vm.network "forwarded_port",
          guest: port[:guest],
          host: port[:host],
          host_ip: "127.0.0.1",
          auto_correct: false
      end

      machine.vm.provision "shell",
        inline: <<-SHELL
          apt-get update
          apt-get install -y python3
        SHELL

      machine.vm.provider "vmware_desktop" do |vm|
        vm.memory = settings[:memory]
        vm.cpus = settings[:cpus]
      end

    end
  end
end
